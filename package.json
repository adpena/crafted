{
	"name": "crafted",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"emdash": {
		"seed": "seed/seed.json"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "wrangler deploy",
		"typecheck": "npm run types && astro check",
		"bootstrap": "emdash init && emdash seed",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:e2e:webkit": "playwright test --project=webkit",
		"test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
		"test:e2e:all": "playwright test",
		"lighthouse": "tsx scripts/lighthouse-audit.ts",
		"lint": "npm run typecheck",
		"verify": "npx tsx scripts/verify-disclaimers.ts",
		"ship": "node scripts/portfolio-release.mjs ship",
		"types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
		"release:prepare": "node scripts/portfolio-release.mjs prepare",
		"release:verify": "node scripts/portfolio-release.mjs verify",
		"backup:site": "python3 scripts/backup-site.py",
		"test:e2e:portfolio": "playwright test e2e/tests/portfolio.spec.ts e2e/tests/portfolio-artifacts.spec.ts --project=chromium --project=webkit --project=\"Mobile Safari\"",
		"preview:seed": "python3 scripts/seed-portfolio-preview.py",
		"test:backup": "python3 -m unittest discover -s tests -p test_portfolio_backup.py"
	},
	"dependencies": {
		"@adpena/notifications": "0.1.1",
		"@astrojs/cloudflare": "14.3.3",
		"@astrojs/react": "7.0.0",
		"@emdash-cms/cloudflare": "1.0.1",
		"astro": "7.3.5",
		"emdash": "1.0.1",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/workers-types": "5.20260928.1",
		"@playwright/test": "1.63.0",
		"chrome-launcher": "1.2.1",
		"lighthouse": "13.5.0",
		"tsx": "4.23.15",
		"vitest": "5.0.2",
		"wrangler": "4.143.0"
	}
}
