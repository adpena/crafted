---
import Base from "../layouts/Base.astro";

const actionTypes = [
	{
		icon: "✍",
		name: "Petition",
		desc: "Collect signatures with a campaign description and photos.",
	},
	{
		icon: "◈",
		name: "Fundraise",
		desc: "Link to ActBlue and show fundraising progress.",
	},
	{
		icon: "✉",
		name: "Letter to Congress",
		desc: "Draft a message using an editable letter template.",
	},
	{
		icon: "☏",
		name: "Call Your Rep",
		desc: "Show a phone number, call script, and talking points.",
	},
	{
		icon: "◴",
		name: "Event RSVP",
		desc: "Collect RSVPs and offer a calendar download.",
	},
	{
		icon: "✦",
		name: "GOTV Pledge",
		desc: "Collect voting pledges and show an election countdown.",
	},
	{
		icon: "✱",
		name: "Newsletter Signup",
		desc: "Collect newsletter subscriptions.",
	},
	{
		icon: "⌘",
		name: "Multi-Step Form",
		desc: "Show different questions based on earlier answers.",
	},
];

const demos = [
	{
		slug: "/action/fund-public-schools",
		name: "Fund Public Schools",
		type: "Petition",
		gradient: "linear-gradient(135deg, #22c55e 0%, #0ea5e9 100%)",
		emoji: "✍",
	},
	{
		slug: "/action/climate-action-now",
		name: "Climate Action Now",
		type: "Fundraise",
		gradient: "linear-gradient(135deg, #84cc16 0%, #059669 100%)",
		emoji: "◈",
	},
	{
		slug: "/action/healthcare-pledge",
		name: "Healthcare Pledge",
		type: "GOTV Pledge",
		gradient: "linear-gradient(135deg, #ef4444 0%, #f59e0b 100%)",
		emoji: "✦",
	},
	{
		slug: "/action/voting-rights-signup",
		name: "Voting Rights",
		type: "Newsletter",
		gradient: "linear-gradient(135deg, #6366f1 0%, #a855f7 100%)",
		emoji: "✱",
	},
	{
		slug: "/action/write-your-rep",
		name: "Write Your Rep",
		type: "Letter to Congress",
		gradient: "linear-gradient(135deg, #0891b2 0%, #4f46e5 100%)",
		emoji: "✉",
	},
	{
		slug: "/action/rally-town-hall",
		name: "Rally Town Hall",
		type: "Event RSVP",
		gradient: "linear-gradient(135deg, #f97316 0%, #dc2626 100%)",
		emoji: "◴",
	},
];

const integrations = [
	"Action Network",
	"Mailchimp",
	"NationBuilder",
	"EveryAction / NGP VAN",
	"Mobilize America",
	"Eventbrite",
	"Facebook Events",
	"SendGrid",
	"Constant Contact",
	"Hustle",
	"Salsa Labs",
	"ActBlue (webhooks)",
];

const builtWith = [
	{ name: "Cloudflare Workers + D1 + KV + R2", note: "Request handling and storage" },
	{ name: "Astro 6 + React 19 islands", note: "HTML pages with interactive forms" },
	{ name: "emdash CMS", note: "Content authoring" },
	{ name: "@adpena/action-pages", note: "npm package (this engine)" },
	{ name: "Anthropic Claude", note: "AI page generator + copy variants" },
	{ name: "Resend", note: "Transactional email" },
	{ name: "Turnstile", note: "Bot protection" },
];

---

<Base
	title="Crafted Action Pages"
	description="An unfinished experiment in campaign forms, page editing, and integrations."
>
	<main id="main-content" class="ap-page">
		<section class="ap-hero">
			<p class="ap-eyebrow">Open source · Unfinished experiment</p>
			<h1 class="ap-title">Crafted Action Pages</h1>
			<p class="ap-subhead">
				I built an EmDash plugin for petitions, signup forms, fundraising pages, and
				event RSVPs. The project remains unfinished; some forms and integrations are incomplete.
			</p>
			<div class="ap-cta-row">
				<a href="#demos" class="btn ap-btn-primary">View example pages</a>
				<a
					href="https://github.com/adpena/action-pages"
					class="btn"
					rel="noopener"
				>
					GitHub →
				</a>
			</div>
		</section>

		<section class="ap-section">
			<h2 class="ap-section-label">Action types</h2>
			<h3 class="ap-section-title">Forms for common campaign tasks</h3>
			<div class="ap-grid ap-grid-actions">
				{actionTypes.map((a) => (
					<article class="ap-card">
						<div class="ap-card-icon" aria-hidden="true">{a.icon}</div>
						<h4 class="ap-card-name">{a.name}</h4>
						<p class="ap-card-desc">{a.desc}</p>
					</article>
				))}
			</div>
		</section>

		<section class="ap-section" id="demos">
			<h2 class="ap-section-label">Example pages</h2>
			<h3 class="ap-section-title">Explore the example pages</h3>
			<p class="ap-subhead">These pages use fictional campaign content and run forms locally. The letter and call examples use fictional representatives; nothing is sent, saved, or charged.</p>
			<div class="ap-grid ap-grid-demos">
				{demos.map((d) => (
					<a href={d.slug} class="ap-demo-card">
						<div
							class="ap-demo-thumb"
							style={`background: ${d.gradient}`}
							aria-hidden="true"
						>
							<span class="ap-demo-emoji">{d.emoji}</span>
						</div>
						<div class="ap-demo-body">
							<div class="ap-demo-slug">{d.slug}</div>
							<div class="ap-demo-name">{d.name}</div>
							<div class="ap-demo-type">{d.type}</div>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="ap-section">
			<h2 class="ap-section-label">Integrations</h2>
			<h3 class="ap-section-title">Connections to campaign tools</h3>
			<p class="ap-subhead">The plugin includes adapters for these services. Each deployment needs its own credentials and configuration.</p>
			<ul class="ap-integrations">
				{integrations.map((i) => (
					<li class="ap-integration">{i}</li>
				))}
			</ul>
		</section>

		<section class="ap-section">
			<h2 class="ap-section-label">Built with</h2>
			<h3 class="ap-section-title">The application stack</h3>
			<dl class="ap-builtwith">
				{builtWith.map((b) => (
					<div class="ap-builtwith-row">
						<dt>{b.name}</dt>
						<dd>{b.note}</dd>
					</div>
				))}
			</dl>
		</section>

		<!-- Case study -->
		<section class="ap-section">
			<h2 class="ap-section-title">How it was built</h2>
			<div class="ap-case-study">
				<h3 class="ap-case-title">Building campaign action pages on Cloudflare</h3>
				<p class="ap-case-desc">
					How the page editor, forms, database, and background integrations fit together.
				</p>
				<p class="ap-case-topics">
					Rendering &middot; Submission storage &middot; Background work
				</p>
				<a
					href="/work/writing/building-action-network-on-cloudflare"
					class="btn ap-btn-secondary"
				>
					Read the case study →
				</a>
			</div>
		</section>

		<section class="ap-footer-cta">
			<h2 class="ap-footer-title">Source code and setup notes</h2>
			<p class="ap-footer-sub">
				The repository documents the experiment and its setup. The examples show the work so far.
			</p>
			<div class="ap-footer-btns">
				<a
					href="https://github.com/adpena/action-pages"
					class="btn ap-btn-primary"
					rel="noopener"
				>
					Browse the source →
				</a>
				<a
					href="/action-pages/embed/"
					class="btn ap-btn-secondary"
				>
					Embed playground →
				</a>
			</div>
		</section>
	</main>
</Base>

<style>
	.ap-page {
		width: 100%;
		max-width: 64rem;
		margin: 0 auto;
		padding: var(--spacing-xl) var(--content-padding) var(--spacing-4xl);
	}

	/* ── Hero ─────────────────────────────────── */
	.ap-hero {
		padding: var(--spacing-2xl) 0 var(--spacing-3xl);
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--spacing-2xl);
	}

	.ap-eyebrow {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-md);
	}

	.ap-title {
		font-size: var(--font-size-4xl);
		margin-bottom: var(--spacing-md);
		max-width: 14ch;
	}

	.ap-subhead {
		font-family: var(--font-serif);
		font-size: var(--font-size-lg);
		color: var(--color-secondary);
		line-height: 1.5;
		max-width: 38rem;
		margin-bottom: var(--spacing-xl);
	}

	.ap-cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.ap-btn-primary {
		background: var(--color-text);
		color: var(--color-bg);
	}

	.ap-btn-primary:hover {
		background: transparent;
		color: var(--color-text);
	}

	/* ── Sections ─────────────────────────────── */
	.ap-section {
		margin-bottom: var(--spacing-4xl);
		scroll-margin-top: var(--spacing-xl);
	}

	.ap-section-label {
		display: block;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-secondary);
		padding-bottom: var(--spacing-xs);
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--spacing-md);
	}

	.ap-section-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-xl);
		max-width: 36rem;
	}

	.ap-grid {
		display: grid;
		gap: var(--spacing-lg);
	}

	.ap-grid-actions {
		grid-template-columns: repeat(4, 1fr);
	}

	/* ── Action cards ─────────────────────────── */
	.ap-card {
		padding: var(--spacing-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		transition: border-color 200ms var(--ease), transform 200ms var(--ease);
	}

	.ap-card:hover {
		border-color: var(--color-text);
		transform: translateY(-2px);
	}

	.ap-card-icon {
		font-size: var(--font-size-2xl);
		line-height: 1;
		margin-bottom: var(--spacing-md);
		color: var(--color-accent);
	}

	.ap-card-name {
		font-family: var(--font-serif);
		font-size: var(--font-size-lg);
		font-weight: 400;
		margin-bottom: var(--spacing-xs);
	}

	.ap-card-desc {
		font-size: var(--font-size-sm);
		color: var(--color-secondary);
		line-height: 1.5;
	}

	/* ── Demo cards ───────────────────────────── */
	.ap-grid-demos {
		grid-template-columns: repeat(3, 1fr);
	}

	.ap-demo-card {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		overflow: hidden;
		transition: border-color 200ms var(--ease), transform 200ms var(--ease);
	}

	.ap-demo-card:hover {
		border-color: var(--color-text);
		transform: translateY(-2px);
	}

	.ap-demo-thumb {
		aspect-ratio: 16 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ap-demo-emoji {
		font-size: 3rem;
		color: rgba(255, 255, 255, 0.92);
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
	}

	.ap-demo-body {
		padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
	}

	.ap-demo-slug {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-secondary);
		margin-bottom: var(--spacing-xs);
		word-break: break-all;
	}

	.ap-demo-name {
		font-family: var(--font-serif);
		font-size: var(--font-size-lg);
		margin-bottom: var(--spacing-xs);
	}

	.ap-demo-type {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	/* ── Integrations ─────────────────────────── */
	.ap-integrations {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
		border-top: 1px solid var(--color-border);
		border-left: 1px solid var(--color-border);
	}

	.ap-integration {
		padding: var(--spacing-lg);
		border-right: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		text-align: center;
	}

	/* ── Built with ───────────────────────────── */
	.ap-builtwith {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin: 0;
	}

	.ap-builtwith-row {
		display: grid;
		grid-template-columns: 20rem 1fr;
		gap: var(--spacing-lg);
		padding: var(--spacing-md) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.ap-builtwith-row:first-child {
		border-top: 1px solid var(--color-border);
	}

	.ap-builtwith dt {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-text);
	}

	.ap-builtwith dd {
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		color: var(--color-secondary);
		margin: 0;
	}

	/* ── Footer CTA ───────────────────────────── */
	.ap-footer-cta {
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		margin-top: var(--spacing-2xl);
	}

	.ap-footer-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-sm);
	}

	.ap-footer-sub {
		font-family: var(--font-serif);
		color: var(--color-secondary);
		max-width: 32rem;
		margin: 0 auto var(--spacing-xl);
		line-height: 1.6;
	}

	/* ── Case study ──────────────────────────── */
	.ap-case-study {
		padding: var(--spacing-xl);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.ap-case-title {
		font-family: var(--font-serif);
		font-size: var(--font-size-xl);
		font-weight: 400;
		margin: 0 0 var(--spacing-sm);
		line-height: 1.3;
	}

	.ap-case-desc {
		font-family: var(--font-serif);
		color: var(--color-secondary);
		line-height: 1.6;
		margin: 0 0 var(--spacing-sm);
	}

	.ap-case-topics {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-secondary);
		letter-spacing: 0.03em;
		margin: 0 0 var(--spacing-lg);
	}

	.ap-footer-btns {
		display: flex;
		justify-content: center;
		gap: var(--spacing-md);
		flex-wrap: wrap;
	}

	/* ── Responsive ───────────────────────────── */
	@media (max-width: 900px) {
		.ap-grid-actions {
			grid-template-columns: repeat(2, 1fr);
		}

		.ap-grid-demos {
			grid-template-columns: repeat(2, 1fr);
		}

		.ap-integrations {
			grid-template-columns: repeat(2, 1fr);
		}

		.ap-builtwith-row {
			grid-template-columns: 1fr;
			gap: var(--spacing-xs);
		}
	}

	@media (max-width: 600px) {
		.ap-page {
			padding-top: var(--spacing-md);
		}

		.ap-hero {
			padding: var(--spacing-lg) 0 var(--spacing-2xl);
		}

		.ap-grid-actions,
		.ap-grid-demos {
			grid-template-columns: 1fr;
		}

		.ap-integrations {
			grid-template-columns: 1fr;
		}

		.ap-cta-row .btn {
			width: 100%;
			text-align: center;
		}

	}
</style>
