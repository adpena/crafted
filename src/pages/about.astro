---
import Base from "../layouts/Base.astro";

import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import WorkWithMe from "../components/WorkWithMe.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "about");
if (!entry) return new Response("About is temporarily unavailable. Contact contact@adpena.com.", { status: 503 });
try { Astro.cache.set(cacheHint); } catch {}
const bio = entry.data as { content?: unknown };
---

<Base title="About">
	<main id="main-content" class="page about-page">
		<div class="terminal" aria-hidden="true">
			<div class="line">$ whoami</div>
			<div class="line" data-type="alejandro peña">&nbsp;</div>
			<div class="line" data-type="austin, tx">&nbsp;</div>
		</div>

		<h1 class="visually-hidden">About Alejandro Peña — Austin, TX.</h1>

		<div class="about-body prose" id="about-body"><PortableText value={bio.content} /></div>
        <WorkWithMe />
	</main>
</Base>



<script>
  const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-type]'));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seenBefore = false;
  try { seenBefore = !!sessionStorage.getItem('about-seen'); sessionStorage.setItem('about-seen', '1'); } catch {}
  if (reducedMotion || seenBefore) {
    lines.forEach(el => { el.textContent = el.dataset.type || ''; });
  } else {
    let delay = 0;
    lines.forEach(el => {
      const text = el.dataset.type || '';
      for (let i = 1; i <= text.length; i++) {
        setTimeout(() => { el.textContent = text.slice(0, i); }, delay + i * 35);
      }
      delay += text.length * 35 + 250;
    });
  }
</script>
